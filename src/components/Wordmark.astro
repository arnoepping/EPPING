---
// Outlined wordmark (G3 shape, from `npm run logo`) with the RGB-split glitch.
import wm from './wordmark.json';
interface Props { tag?: 'h1' | 'div' | 'span'; size?: string }
const { tag: Tag = 'div', size = 'clamp(64px,17vw,200px)' } = Astro.props;
---
<Tag class="wm" style={`--wm-size:${size}`}><svg viewBox={wm.viewBox} role="img" aria-label="EPPING"><path class="wm-a" d={wm.d}/><path class="wm-b" d={wm.d}/><path class="wm-t" d={wm.d}/></svg></Tag>
<style>
  /* SVG units: the path is set at 100, so 2 = .02em of the old text version */
  .wm{display:inline-block;margin:0;line-height:0}
  .wm svg{display:block;height:calc(var(--wm-size) * .86);width:auto;overflow:visible}
  .wm-t{fill:var(--text)}
  .wm-a,.wm-b{mix-blend-mode:screen}
  .wm-a{fill:var(--cyan);transform:translate(-2px,0);animation:wm-glitch-a 4.2s infinite steps(1)}
  .wm-b{fill:var(--pink);transform:translate(2px,0);animation:wm-glitch-b 4.2s infinite steps(1)}
  @keyframes wm-glitch-a{0%,86%,100%{transform:translate(-2px,0);clip-path:none}88%{transform:translate(-5px,1px);clip-path:inset(12% 0 55% 0)}91%{transform:translate(3px,-1px);clip-path:inset(60% 0 8% 0)}94%{transform:translate(-2px,0);clip-path:none}}
  @keyframes wm-glitch-b{0%,86%,100%{transform:translate(2px,0);clip-path:none}88%{transform:translate(5px,-1px);clip-path:inset(48% 0 20% 0)}91%{transform:translate(-3px,1px);clip-path:inset(5% 0 70% 0)}94%{transform:translate(2px,0);clip-path:none}}
  @media (prefers-reduced-motion:reduce){.wm-a,.wm-b{animation:none}}
</style>
