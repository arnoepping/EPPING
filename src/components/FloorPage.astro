---
// One service page: used inside the entrance overlay and as the /<slug>/ route.
import { CONTACT, FLOORS, type Floor } from '../content/floors.ts';
import { mailtoHref, whatsappHref, soundcloudEmbed } from '../lib/links.ts';
interface Props { f: Floor; standalone?: boolean }
const { f, standalone = false } = Astro.props;
const others = FLOORS.filter((o) => o.slug !== f.slug);
---
<div class="fp-in">
  {standalone ? <a class="fp-back" href="/">← Back to the street</a> : <a class="fp-back" href="/" data-back>← Back to the roof</a>}
  <p class="fp-k">Floor {f.n} · {f.tagline}</p>
  <h1 class="fp-h" tabindex="-1">{f.name}</h1>
  <p class="fp-head">{f.headline}</p>
  <p class="fp-intro">{f.intro}</p>
  {f.event && <div class="fp-event"><span>Next night</span><b>{f.event.date}</b><span>{f.event.place} · {f.event.note}</span></div>}
  <div class="fp-cols">
    <div class="fp-body">{f.body.map((b) => <p>{b}</p>)}</div>
    <ul class="fp-list">{f.includes.map((x) => <li>{x}</li>)}</ul>
  </div>
  <iframe class:list={['fp-sc', { 'fp-sc-set': f.mix.embed }]} title={`${f.mix.title} on SoundCloud`} loading="lazy" allow="autoplay; encrypted-media" src={soundcloudEmbed(f.mix.embed ?? f.mix.url)}></iframe>
  <div class="fp-contact">
    <h2>{f.cta}</h2>
    <div class="fp-btns">
      <a class="btn-wa" href={whatsappHref(CONTACT.whatsapp, f.whatsapp)} target="_blank" rel="noopener">WhatsApp</a>
      <a class="btn-mail" href={mailtoHref(CONTACT.email, f.mail.subject, f.mail.body)}>Email</a>
    </div>
    <p class="fp-addr"><span>{CONTACT.email}</span><button type="button" data-copy={CONTACT.email}>Copy</button> · <span>{CONTACT.whatsappLabel}</span></p>
    <p class="fp-social"><a href={CONTACT.instagram} target="_blank" rel="noopener">Instagram {CONTACT.instagramLabel} ↗</a><a href={CONTACT.soundcloud} target="_blank" rel="noopener">All mixes on SoundCloud ↗</a></p>
  </div>
  <nav class="fp-others" aria-label="Other floors">{others.map((o) => <a href={`/${o.slug}/`} data-floor={standalone ? undefined : o.slug}>{o.name} →</a>)}</nav>
</div>
