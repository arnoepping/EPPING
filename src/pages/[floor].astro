---
import FloorRoute from '../components/FloorRoute.astro';
import { FLOORS, type Floor } from '../content/floors.ts';
export function getStaticPaths() { return FLOORS.map((f) => ({ params: { floor: f.slug }, props: { f } })); }
const { f } = Astro.props as { f: Floor };
---
<FloorRoute f={f} lang="en" />
