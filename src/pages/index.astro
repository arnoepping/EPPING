---
import Base from '../layouts/Base.astro';
import Entrance from '../components/Entrance.astro';
import '../styles/entrance.css';
---
<Base title="EPPING | Rave wedding & party DJ in Amsterdam" description="House and techno DJ in Amsterdam for rave weddings, private events and our own pop-up parties. Club sound and lights included.">
  <!-- decide before first paint: 3D-capable devices get the street still instead of the static page (it comes back after 8 s if the street never arrives),
       and start downloading the street model and its decoder now instead of after the 3D code -->
  <script slot="head" is:inline>
    (function () {
      var h = document.documentElement;
      try { if (matchMedia('(prefers-reduced-motion: reduce)').matches || !document.createElement('canvas').getContext('webgl2')) return; } catch (e) { return; }
      h.classList.add('ent-boot');
      ['models/street.glb', 'draco/draco_wasm_wrapper.js', 'draco/draco_decoder.wasm'].forEach(function (u) {
        var l = document.createElement('link'); l.rel = 'preload'; l.as = 'fetch'; l.crossOrigin = 'anonymous'; l.href = u; document.head.appendChild(l);
      });
      setTimeout(function () { if (!h.classList.contains('ent-3d')) h.classList.remove('ent-boot'); }, 8000);
    })();
  </script>
  <Entrance />
</Base>
